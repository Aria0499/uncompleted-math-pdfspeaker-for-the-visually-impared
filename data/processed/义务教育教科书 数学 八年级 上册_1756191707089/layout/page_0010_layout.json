        200,
        744,
        371
      ],
      "pdf_page_bbox": [
        63.63,
        92.12,
        343.18,
        170.97
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "三边都不相等的三角形三角形 底边和腰不相等的等腰三角形等腰三角形等边三角形"
          }
        ]
      },
      "bbox": [
