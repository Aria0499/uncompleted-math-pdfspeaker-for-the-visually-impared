        455.84,
        215.93
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "根据全等三角形的定义，如果 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "满足三条边分别相等，三个角分别相等，即"
          }
        ]
      },
      "bbox": [
        81,
        319,
        869,
        369
      ],
      "reading_order": 3,
      "original_image_bbox": [
        176,
        979,
