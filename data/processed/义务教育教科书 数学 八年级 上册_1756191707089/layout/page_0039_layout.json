      ]
    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "\\scriptstyle \\angle A = \\angle A ^ { \\prime } , \\angle B = \\angle B ^ { \\prime } , \\angle C = \\angle C ^ { \\prime } ,",
        "math_type": "latex",
        "image_source": {
          "path": "images/785a596af88a34161b54f48be47dd6964c3645ecbd7b7d8b47f06da8120156b9.jpg"
