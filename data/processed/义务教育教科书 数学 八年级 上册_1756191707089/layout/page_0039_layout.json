        453.23,
        271.94
      ]
    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "A B = A ^ { \\prime } B ^ { \\prime } , ~ B C = B ^ { \\prime } C ^ { \\prime } , ~ C A = C ^ { \\prime } A ^ { \\prime } ,",
        "math_type": "latex",
        "image_source": {
          "path": "images/b0fa4bca0cd15842b60ad0d8b5674876f172528cb9a677fadd04217b02b12176.jpg"
        }
