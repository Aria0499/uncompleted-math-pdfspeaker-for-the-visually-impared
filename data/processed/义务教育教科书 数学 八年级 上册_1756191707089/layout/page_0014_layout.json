    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图13.2-6（1），画 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "的 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A"
          },
          {
            "type": "text",
            "content": "的平分线AD，交 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A"
          },
          {
            "type": "text",
            "content": "所对的边BC于点D，所得线段AD叫作 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "的角平分线．三角形的三条角平分线相交于一"
          }
        ]
      },
