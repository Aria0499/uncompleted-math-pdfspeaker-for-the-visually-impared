      ],
      "pdf_page_bbox": [
        63.63,
        400.16,
        476.7,
        437.01
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图13.2-5（1），连接 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "的顶点A和它所对的边BC的中点D，所得线段AD叫作 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "的边BC上的中线."
          }
        ]
      },
      "bbox": [
