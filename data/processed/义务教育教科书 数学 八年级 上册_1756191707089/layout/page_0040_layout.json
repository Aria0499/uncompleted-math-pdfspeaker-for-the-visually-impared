    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图14.2-3，由 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A ^ { \\prime } { = } \\angle A"
          },
          {
            "type": "text",
            "content": "可知，如果使点 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与点A重合，并且使射线 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } B ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与射线AB重合，那么射线 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与射线AC重合.再由 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } B ^ { \\prime } { = } A B , ~ A ^ { \\prime } C ^ { \\prime } { = } A C"
          },
          {
            "type": "text",
            "content": "，可知点 "
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime }"
          },
          {
            "type": "equation_inline",
            "content": "C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "分别与点B，C重合.这样， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "的三个顶点与"
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "的三个顶点分别重合， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "能够完全重合，因而 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime } { \\cong } \\triangle A B C"
          }
        ]
      },
