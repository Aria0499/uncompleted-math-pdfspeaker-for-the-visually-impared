        328.68
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "两边和它们的夹角分别相等的两个三角形全等（可以简写成“边角边”或"
          },
          {
            "type": "equation_inline",
            "content": "^ { 6 } \\mathrm { S A S ^ { 9 } } \\mathrm { ) }"
          }
        ]
      },
      "bbox": [
        125,
        454,
        914,
        501
      ],
      "reading_order": 8,
      "original_image_bbox": [
        271,
        1394,
        1987,
        1538
      ],
      "model_image_bbox": [
        141,
        726,
        1034,
        801
      ],
      "pdf_page_bbox": [
        65.19,
        334.58,
        476.7,
        369.21
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "因为全等三角形的对应边相等、对应角相等，所以在证明线段相等或角相等时，可以通过证明它们是全等三角形的对应边或对应角来解决."
          }
        ]
      },
      "bbox": [
        125,
        510,
        914,
        560
      ],
      "reading_order": 9,
      "original_image_bbox": [
        271,
        1566,
        1987,
        1719
      ],
      "model_image_bbox": [
