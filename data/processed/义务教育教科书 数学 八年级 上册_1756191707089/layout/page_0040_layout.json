    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "分析：如果能证明 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C { \\cong } \\triangle A B D"
          },
          {
            "type": "text",
            "content": "，就可以得出 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle C ="
          },
          {
            "type": "equation_inline",
            "content": "\\angle D ."
          },
          {
            "type": "text",
            "content": "，由题意可知， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B D"
          },
          {
            "type": "text",
            "content": "具备“边角边”的条件."
          }
        ]
      },
