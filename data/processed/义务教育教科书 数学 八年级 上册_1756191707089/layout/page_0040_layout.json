    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "由探究2可以得到以下基本事实，用它可以判定两个三角形全等："
          }
        ]
      },
      "bbox": [
        169,
        425,
        830,
        446
      ],
      "reading_order": 7,
      "original_image_bbox": [
        367,
        1305,
