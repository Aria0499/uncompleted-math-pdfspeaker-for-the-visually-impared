          {
            "item_type": "text",
            "item_content": [
              {
                "type": "text",
                "content": "证明： "
              },
              {
                "type": "equation_inline",
                "content": "\\because A B"
              },
              {
                "type": "text",
                "content": "平分 "
              },
              {
                "type": "equation_inline",
                "content": "\\angle C A D"
              },
              {
                "type": "equation_inline",
                "content": "\\therefore \\angle C A B = \\angle D A B ."
              }
            ]
          },
          {
            "item_type": "text",
            "item_content": [
              {
                "type": "text",
                "content": "在 "
              },
              {
                "type": "equation_inline",
                "content": "\\triangle A B C"
              },
              {
                "type": "text",
                "content": "和 "
              },
              {
                "type": "equation_inline",
                "content": "\\triangle A B D"
              },
              {
                "type": "text",
                "content": "中，"
              }
            ]
          },
          {
            "item_type": "text",
            "item_content": [
              {
                "type": "equation_inline",
                "content": "\\left\\{ \\begin{array} { l } { A C = A D , } \\\\ { \\angle C A B = \\angle D A B , } \\\\ { A B = A B , } \\end{array} \\right."
              }
            ]
          },
          {
            "item_type": "text",
            "item_content": [
              {
                "type": "text",
                "content": "∴ △ABC≌△ABD (SAS). "
              },
              {
                "type": "equation_inline",
                "content": "\\therefore \\angle C = \\angle D ."
              }
            ]
          }
        ]
