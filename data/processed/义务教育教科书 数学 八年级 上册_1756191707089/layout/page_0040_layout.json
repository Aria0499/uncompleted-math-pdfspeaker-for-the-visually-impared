      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "例1如图14.2-4， "
          },
          {
            "type": "equation_inline",
            "content": "A C = A D"
          },
          {
            "type": "text",
            "content": "，AB平分 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle C A D"
          },
          {
            "type": "text",
            "content": "，求证 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle C = \\angle D"
          }
        ]
      },
      "bbox": [
        125,
        567,
        729,
        616
      ],
      "reading_order": 10,
      "original_image_bbox": [
