    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "点（x，y）关于x轴对称的点的坐标为 "
          },
          {
            "type": "equation_inline",
            "content": "( x , \\ - y )"
          }
        ]
      },
      "bbox": [
        147,
        354,
        675,
        375
      ],
      "reading_order": 5,
      "original_image_bbox": [
        319,
