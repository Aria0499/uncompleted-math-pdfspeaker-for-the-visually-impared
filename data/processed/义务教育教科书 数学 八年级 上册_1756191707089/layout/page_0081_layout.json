        352.05,
        276.36
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "点（x，y）关于y轴对称的点的坐标为 "
          },
          {
            "type": "equation_inline",
            "content": "( - x , \\ y )"
          }
        ]
      },
      "bbox": [
        147,
        383,
        668,
        402
      ],
      "reading_order": 6,
      "original_image_bbox": [
        319,
