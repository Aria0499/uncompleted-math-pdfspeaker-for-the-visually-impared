      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图1，任意画 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "，在 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle B A C"
          },
          {
            "type": "text",
            "content": "的内部作 "
          },
          {
            "type": "equation_inline",
            "content": "A C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": ",使 "
          },
          {
            "type": "equation_inline",
            "content": "A C ^ { \\prime } { = } A C"
          },
          {
            "type": "text",
            "content": "，连接 "
          },
          {
            "type": "equation_inline",
            "content": "B C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "．这样 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "有两边分别相等.让 "
          },
          {
            "type": "equation_inline",
            "content": "A C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "绕点A旋转，使 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "在AB的同旁，测量 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle B A C"
          },
          {
            "type": "text",
            "content": ", "
          },
          {
            "type": "equation_inline",
            "content": "\\angle B A C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "．可以发现："
          }
        ]
      },
