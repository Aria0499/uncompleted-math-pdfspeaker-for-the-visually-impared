      "pdf_page_bbox": [
        59.98,
        367.0,
        441.75,
        420.8
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "先来探究在两边分别相等的基础上再添加它们夹角相等的情况."
          }
        ]
      },
      "bbox": [
        115,
        576,
        643,
        621
      ],
      "reading_order": 9,
      "original_image_bbox": [
