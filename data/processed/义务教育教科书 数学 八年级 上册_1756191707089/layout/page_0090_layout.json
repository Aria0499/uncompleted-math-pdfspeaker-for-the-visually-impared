    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "D是斜梁AB的中点，立柱BC，DE 垂直于横梁AC，AB=7.4m， "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A ="
