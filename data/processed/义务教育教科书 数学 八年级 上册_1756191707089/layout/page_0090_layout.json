    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图15.3-8，在 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "中， "
          },
          {
            "type": "equation_inline",
            "content": "\\angle C = 9 0 ^ { \\circ } , \\angle A = 3 0 ^ { \\circ }"
          },
          {
            "type": "text",
            "content": "测量 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A"
          },
          {
            "type": "text",
            "content": "所对的直角边BC与斜边AB，你能得到什么结论？再画几个满足条件的三角形，你得到的结论还成立吗？证明你的结论."
          }
        ]
      },
      "bbox": [
        147,
