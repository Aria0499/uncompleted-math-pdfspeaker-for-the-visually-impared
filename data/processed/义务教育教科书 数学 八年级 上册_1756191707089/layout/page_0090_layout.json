    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "在直角三角形中，如果一个锐角等于 "
          },
          {
            "type": "equation_inline",
            "content": "3 0 ^ { \\circ }"
          },
          {
            "type": "text",
            "content": "，那么它所对的直角边等于斜边的一半."
          }
        ]
      },
      "bbox": [
