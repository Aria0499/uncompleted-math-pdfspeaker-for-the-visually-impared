    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "通过测量发现：在 "
          },
          {
            "type": "equation_inline",
            "content": "\\mathrm { R t } \\triangle A B C"
          },
          {
            "type": "text",
            "content": "中，如果 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A = 3 0 ^ { \\circ }"
          },
          {
            "type": "text",
            "content": "，那么直角边BC等于斜边AB的一半．下面证明这一结论."
          }
        ]
      },
      "bbox": [
        125,
        255,
        914,
        303
      ],
      "reading_order": 6,
      "original_image_bbox": [
        271,
        783,
        1987,
        930
      ],
      "model_image_bbox": [
        141,
        408,
        1034,
        484
      ],
      "pdf_page_bbox": [
        65.19,
        187.92,
        476.7,
        223.3
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "要证明 "
          },
          {
            "type": "equation_inline",
            "content": "B C = { \\frac { 1 } { 2 } } A B"
          },
          {
            "type": "text",
            "content": "，只要证明 "
          },
          {
            "type": "equation_inline",
            "content": "2 B C = A B"
          },
          {
            "type": "text",
            "content": "．为此可以构造长为2BC的线段，证明它和AB相等即可."
          }
        ]
      },
      "bbox": [
        122,
        314,
        916,
        381
      ],
      "reading_order": 7,
      "original_image_bbox": [
        265,
        964,
        1991,
        1170
      ],
      "model_image_bbox": [
        138,
        502,
        1036,
        609
      ],
      "pdf_page_bbox": [
        63.63,
        231.4,
        477.74,
        280.78
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图15.3-9，延长BC到D，使CD=BC，连接AD，则AC是BD的垂直平分线，所以 "
          },
          {
            "type": "equation_inline",
            "content": "A B ="
          },
          {
            "type": "text",
            "content": "AD.又因为 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle B = 9 0 ^ { \\circ } - \\angle B A C = 9 0 ^ { \\circ } - 3 0 ^ { \\circ } = 6 0 ^ { \\circ }"
          },
          {
            "type": "text",
            "content": ",所以 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B D"
          },
          {
            "type": "text",
            "content": "是等边三角形，所以 "
          },
          {
            "type": "equation_inline",
            "content": "B D = A B"
          },
          {
            "type": "text",
            "content": ".又"
          },
          {
            "type": "equation_inline",
            "content": "B D { = } 2 B C"
          },
          {
            "type": "text",
            "content": "，所以 "
          },
          {
            "type": "equation_inline",
            "content": "B C = { \\frac { 1 } { 2 } } A B"
          },
          {
            "type": "text",
            "content": "．由此可以得到："
          }
        ]
      },
      "bbox": [
        122,
        388,
        648,
        538
      ],
