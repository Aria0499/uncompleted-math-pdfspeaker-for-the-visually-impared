          {
            "type": "text",
            "content": "解： "
          },
          {
            "type": "equation_inline",
            "content": "\\because D E \\bot A C , B C \\bot A C , \\angle A = 3 0 ^ { \\circ }"
          }
        ]
      },
      "bbox": [
