    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "为了判断点 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与点A是否重合，我们讨论射线CA上除点C，A外的点与点B的连线和边AB的大小关系."
          }
        ]
      },
      "bbox": [
