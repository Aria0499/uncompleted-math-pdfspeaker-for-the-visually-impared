    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图15.1-4, "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "和 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "关于直线MN对称，点 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } , B ^ { \\prime } , C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "分别是点A，B，C的对称点，线段 "
          },
          {
            "type": "equation_inline",
            "content": "A A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": ", "
          },
          {
            "type": "equation_inline",
            "content": "B B ^ { \\prime }"
          },
          {
            "type": "text",
            "content": ", "
          },
          {
            "type": "equation_inline",
            "content": "C C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与直线MN有什么关系？其他对称点呢？"
          }
        ]
      },
      "bbox": [
