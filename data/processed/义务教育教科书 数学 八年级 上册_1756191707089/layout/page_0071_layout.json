    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "图15.1-4中，点A与 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "是对称点，设 "
          },
          {
            "type": "equation_inline",
            "content": "A A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "交对称轴MN于点P，将"
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "或 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "沿MN折叠后，点A与 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "重合．于是有"
          }
        ]
      },
      "bbox": [
        81,
        225,
        872,
        276
      ],
      "reading_order": 5,
      "original_image_bbox": [
