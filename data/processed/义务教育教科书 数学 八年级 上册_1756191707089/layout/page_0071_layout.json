      ]
    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "A P = A ^ { \\prime } P , \\angle M P A = \\angle M P A ^ { \\prime } = 9 0 ^ { \\circ } .",
        "math_type": "latex",
        "image_source": {
          "path": "images/f0045d8f6b0401e971f35b65e22f82bf02fe7ed21f7f5e89a245ab20eefead67.jpg"
