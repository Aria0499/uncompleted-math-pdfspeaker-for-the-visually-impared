            "item_type": "text",
            "item_content": [
              {
                "type": "text",
                "content": "证明：如图13.3-2，过点A作直线L，使 "
              },
              {
                "type": "equation_inline",
                "content": "l / / B C"
              },
              {
                "type": "equation_inline",
                "content": "\\because \\quad l / / B C ,"
              }
            ]
          },
          {
            "item_type": "text",
            "item_content": [
              {
                "type": "equation_inline",
                "content": "\\therefore \\angle 2 = \\angle 4"
              },
              {
                "type": "text",
                "content": "(两直线平行，内错角相等).同理 "
              },
              {
                "type": "equation_inline",
                "content": "\\angle 3 = \\angle 5 ."
              }
            ]
          },
          {
            "item_type": "text",
            "item_content": [
              {
                "type": "equation_inline",
                "content": "\\because < 1 , \\ \\angle 4 , \\ \\angle 5"
              },
              {
                "type": "text",
                "content": "组成平角，"
              }
            ]
          },
          {
            "item_type": "text",
            "item_content": [
              {
                "type": "equation_inline",
                "content": "\\therefore \\angle 1 + \\angle 4 + \\angle 5 = 1 8 0 ^ { \\circ }"
              },
              {
                "type": "text",
                "content": "（平角定义)."
              }
            ]
          },
          {
            "item_type": "text",
            "item_content": [
              {
                "type": "equation_inline",
                "content": "\\therefore \\angle 1 + \\angle 2 + \\angle 3 = 1 8 0 ^ { \\circ }"
              },
              {
                "type": "text",
                "content": "（等量代换)."
              }
            ]
          }
        ]
      },
