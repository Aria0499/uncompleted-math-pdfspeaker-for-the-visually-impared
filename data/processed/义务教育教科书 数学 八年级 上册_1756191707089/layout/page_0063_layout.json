    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图2， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C { \\cong } \\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "．把 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": ", "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "剪下来，用它们拼图，使边BC 与边 "
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "重合，顶点A与顶点 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "不重合，画出你拼出的图形.在你画出的图形中，连接 "
          },
          {
            "type": "equation_inline",
            "content": "A A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "，用测量、折纸等方法猜想BC，"
          },
          {
            "type": "equation_inline",
            "content": "A A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "有什么关系，然后用全等三角形的知识证明你的猜想."
          }
        ]
      },
