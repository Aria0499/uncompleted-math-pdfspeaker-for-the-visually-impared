    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "（1）作线段 "
          },
          {
            "type": "equation_inline",
            "content": "A B = c"
          }
        ]
      },
      "bbox": [
        169,
