    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "分析：如果 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B D { \\cong } \\triangle A C D"
          },
          {
            "type": "text",
            "content": "，那么 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A D B = \\angle A D C"
          },
          {
            "type": "text",
            "content": "，从而有 "
          },
          {
            "type": "equation_inline",
            "content": "A D \\perp B C"
          }
        ]
      },
