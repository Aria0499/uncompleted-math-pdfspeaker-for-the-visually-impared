    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "（2）分别以点A，B为圆心，线段b，a为半径作弧，两弧相交于点C；"
          }
        ]
      },
      "bbox": [
        169,
