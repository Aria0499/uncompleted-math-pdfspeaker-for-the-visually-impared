        868
      ],
      "pdf_page_bbox": [
        63.63,
        364.05,
        477.74,
        400.16
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图14.2-12，已知三条线段a，b，c（其中任意两条线段的和大于第三条线段），求作 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "，使其三边分别为a，b，c."
          }
        ]
      },
      "bbox": [
        125,
