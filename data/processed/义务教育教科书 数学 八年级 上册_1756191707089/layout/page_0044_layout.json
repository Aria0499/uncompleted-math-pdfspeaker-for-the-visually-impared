    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "例3在如图14.2-14所示的三角形钢架中， "
          },
          {
            "type": "equation_inline",
            "content": "A B { = } A C"
          },
          {
            "type": "text",
            "content": "，AD是连接点A与BC中点D的支架.求证 "
          },
          {
            "type": "equation_inline",
            "content": "A D \\perp B C"
          }
        ]
      },
      "bbox": [
        125,
        838,
