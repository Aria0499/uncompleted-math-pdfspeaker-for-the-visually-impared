    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "的三个顶点与 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "的三个顶点分别重合， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "能够完全重合，因而 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime } { \\cong } \\triangle A B C"
          }
        ]
      },
      "bbox": [
        125,
        295,
        916,
        345
      ],
      "reading_order": 3,
      "original_image_bbox": [
