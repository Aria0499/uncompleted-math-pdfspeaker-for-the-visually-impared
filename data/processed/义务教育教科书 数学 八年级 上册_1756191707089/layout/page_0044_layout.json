  "blocks": [
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图14.2-11，由 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } B ^ { \\prime } { = } A B"
          },
          {
            "type": "text",
            "content": "可知，如果使点"
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与点A重合，点 "
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "在射线AB上，那么点 "
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与点B重合.另外，使点 "
          },
          {
            "type": "equation_inline",
            "content": "C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "落在直线AB的含有点C的一侧.由于点C是以点A为圆心、AC为半径的圆和以点B为圆心、BC为半径的圆的交点，点 "
          },
          {
            "type": "equation_inline",
            "content": "C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "是以点 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "为圆心、 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "为半径的圆和以点 "
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "为圆心、 "
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "为半径的圆的交点，所以由 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } C ^ { \\prime } { = } A C"
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime } C ^ { \\prime } { = } B C"
          },
          {
            "type": "text",
            "content": "可知点 "
          },
          {
            "type": "equation_inline",
            "content": "C ^ { \\prime } ."
          },
          {
            "type": "text",
            "content": "与点C重合.这样， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          }
        ]
      },
      "bbox": [
        122,
