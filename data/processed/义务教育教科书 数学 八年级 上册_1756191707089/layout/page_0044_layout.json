    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "（3）连接AC，BC，则 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "就是所求作的三角形."
          }
        ]
      },
      "bbox": [
        169,
