            "type": "text",
            "content": "是等边三角形，E是边AC 上的点，且 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle 1 = \\angle 2"
          },
          {
            "type": "equation_inline",
            "content": "C D = B E"
          },
