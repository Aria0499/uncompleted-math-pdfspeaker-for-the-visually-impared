    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "7.如图，厂房屋顶钢架外框是等腰三角形，其中 "
          },
          {
            "type": "equation_inline",
            "content": "A B { = } A C"
