    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图14.3-4，OC是 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A O B"
          },
          {
            "type": "text",
            "content": "的平分线.点 "
          },
          {
            "type": "equation_inline",
            "content": "P _ { 1 }"
          },
          {
            "type": "text",
            "content": ","
          },
          {
            "type": "equation_inline",
            "content": "P _ { \\mathrm { ~ 2 ~ } } , \\ P _ { \\mathrm { ~ 3 ~ } } , \\ \\cdots"
          },
          {
            "type": "text",
            "content": "在OC上，过点 "
          },
          {
            "type": "equation_inline",
            "content": "P _ { 1 } , \\ P _ { 2 } , \\ P _ { 3 } , \\ \\cdots"
          },
          {
            "type": "text",
            "content": "分别画OA与OB的垂线，垂足分别为 "
          },
          {
            "type": "equation_inline",
            "content": "D _ { 1 }"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "E _ { 1 } , \\ D _ { 2 }"
          },
          {
            "type": "equation_inline",
            "content": "E _ { 2 }"
          },
          {
            "type": "equation_inline",
            "content": "D _ { 3 }"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "E _ { 3 } \\cdots"
          },
          {
            "type": "text",
            "content": "，分别比较 "
          },
          {
            "type": "equation_inline",
            "content": "P _ { 1 } D _ { 1 }"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "P _ { 1 } E _ { 1 } , \\ P _ { 2 } D _ { 2 }"
          },
          {
            "type": "text",
            "content": "与"
          },
          {
            "type": "equation_inline",
            "content": "P _ { 2 } E _ { 2 } , \\ P _ { 3 } D _ { 3 }"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "P _ { 3 } E _ { 3 } \\cdots"
          },
          {
            "type": "text",
            "content": "，你有什么发现？"
          }
        ]
      },
