          {
            "type": "equation_inline",
            "content": "\\scriptstyle O A ^ { \\prime } = O A , A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "就是点A关于直线l的对称点；"
          }
        ]
      },
