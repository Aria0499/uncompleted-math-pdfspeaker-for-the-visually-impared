        1019
      ],
      "pdf_page_bbox": [
        357.26,
        438.49,
        469.92,
        469.44
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "由此我们得到作一个角 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A ^ { \\prime } O ^ { \\prime } B ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "等于已知角 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A O B"
          },
          {
            "type": "text",
            "content": "的方法."
          }
        ]
      },
      "bbox": [
        169,
        734,
        771,
        755
      ],
