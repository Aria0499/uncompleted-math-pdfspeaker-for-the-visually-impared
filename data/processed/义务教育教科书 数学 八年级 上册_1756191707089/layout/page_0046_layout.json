    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "显然，这样的三角形是容易作出的.如图14.2-15(2)，在 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A O B"
          },
          {
            "type": "text",
            "content": "的边OA，OB上分别取点C，D，连接CD，得到 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle C O D , ~ \\angle A O B"
          },
          {
            "type": "text",
            "content": "就是"
          },
          {
            "type": "equation_inline",
            "content": "\\triangle C O D"
          },
          {
            "type": "text",
            "content": "的一个内角.再作出 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle C ^ { \\prime } O ^ { \\prime } D ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "（图14.2-15(3))，使 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle C ^ { \\prime } O ^ { \\prime } D ^ { \\prime } \\cong \\triangle C O D"
          },
          {
            "type": "text",
            "content": "，则 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle C ^ { \\prime } O ^ { \\prime } D ^ { \\prime } ="
          },
          {
            "type": "equation_inline",
            "content": "\\angle C O D = \\angle A O B"
          }
        ]
      },
      "bbox": [
        122,
        564,
        646,
        727
      ],
      "reading_order": 10,
      "original_image_bbox": [
        265,
        1732,
        1404,
        2232
      ],
      "model_image_bbox": [
        138,
        902,
        731,
        1163
      ],
      "pdf_page_bbox": [
        63.63,
