        336.92,
        535.76
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "为了作图方便，一般取 "
          },
          {
            "type": "equation_inline",
            "content": "O C { = } O D"
          }
        ]
      },
      "bbox": [
        685,
        595,
        901,
        637
      ],
      "reading_order": 11,
      "original_image_bbox": [
        1489,
        1827,
        1958,
        1956
      ],
      "model_image_bbox": [
        775,
        952,
