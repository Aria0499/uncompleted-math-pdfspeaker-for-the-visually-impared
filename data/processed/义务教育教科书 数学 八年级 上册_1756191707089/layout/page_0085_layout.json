        "attribute": "unordered",
        "list_items": [
          {
            "item_type": "text",
            "item_content": [
              {
                "type": "text",
                "content": "等腰三角形底边上的中线、高及顶角平分线重合（简写成“三线合”）."
              }
            ]
          },
          {
            "item_type": "text",
            "item_content": [
              {
                "type": "text",
                "content": "由上面的探究过程获得启发，可以利用三角形的全等证明这些性质."
