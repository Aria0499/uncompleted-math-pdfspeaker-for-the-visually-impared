            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "中，D是BC的中点， "
          },
          {
            "type": "equation_inline",
            "content": "D E \\bot A B , D F \\bot A C"
          },
          {
            "type": "text",
            "content": "，垂足分别为E，F, "
          },
          {
            "type": "equation_inline",
            "content": "B { E } { = } C F"
          },
          {
            "type": "text",
            "content": "．求证：AD是 "
