    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "等边三角形的三个角都相等，并且每一个角都等于 "
          },
          {
            "type": "equation_inline",
            "content": "6 0 ^ { \\circ }"
          }
        ]
      },
      "bbox": [
        81,
        322,
        599,
        369
      ],
      "reading_order": 7,
      "original_image_bbox": [
        176,
        988,
        1302,
