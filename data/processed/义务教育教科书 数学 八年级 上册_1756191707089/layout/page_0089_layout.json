    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "把等腰三角形的性质用于等边三角形，能得到什么结论？一个三角形满足什么条件才是等边三角形？"
          }
        ]
      },
      "bbox": [
        103,
