    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "由等腰三角形的性质和判定方法，可以得到："
          }
        ]
      },
      "bbox": [
        127,
        293,
        579,
        314
      ],
      "reading_order": 6,
      "original_image_bbox": [
        276,
        899,
