        312.41,
        271.94
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "三个角都相等的三角形是等边三角形."
          }
        ]
      },
      "bbox": [
        125,
        378,
        508,
        399
      ],
