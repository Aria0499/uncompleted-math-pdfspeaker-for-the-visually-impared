      ],
      "pdf_page_bbox": [
        53.72,
        287.41,
        441.75,
        324.26
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "同样地，通过证明两个三角形全等，可以得到："
          }
        ]
      },
      "bbox": [
        81,
        454,
        601,
        505
      ],
      "reading_order": 16,
      "original_image_bbox": [
        176,
