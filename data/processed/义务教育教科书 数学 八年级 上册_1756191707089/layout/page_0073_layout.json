        808
      ],
      "pdf_page_bbox": [
        42.25,
        334.58,
        313.45,
        372.16
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "与线段两个端点距离相等的点在这条线段的垂直平分线上."
          }
        ]
      },
      "bbox": [
        81,
        512,
        601,
        562
      ],
      "reading_order": 17,
      "original_image_bbox": [
        176,
        1572,
