      "pdf_page_bbox": [
        42.25,
        377.32,
        313.45,
        414.17
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "请你自己证明这个结论."
          }
        ]
      },
      "bbox": [
        641,
        486,
        857,
        529
      ],
      "reading_order": 18,
      "original_image_bbox": [
        1393,
        1492,
