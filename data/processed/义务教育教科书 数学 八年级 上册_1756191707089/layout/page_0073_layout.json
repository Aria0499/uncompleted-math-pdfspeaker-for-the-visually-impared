        1624
      ],
      "model_image_bbox": [
        725,
        777,
        970,
        846
      ],
      "pdf_page_bbox": [
        334.31,
        358.16,
        446.97,
        389.85
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "从上面两个结论可以看出，线段垂直平分线上的点与这条线段两个端点的距离相等；反过来，与线段两个端点距离相等的点在这条线段的垂直平分线上.所以线段的垂直平分线可以看成与这条线段两个端点距离相等的所有点的集合."
          }
        ]
      },
      "bbox": [
        78,
        567,
        874,
        675
      ],
      "reading_order": 19,
      "original_image_bbox": [
        169,
