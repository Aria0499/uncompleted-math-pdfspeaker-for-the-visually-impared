        457
      ],
      "pdf_page_bbox": [
        88.14,
        193.82,
        233.13,
        210.77
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "在小学，通过度量或剪拼，我们已经知道三角形的内角和等于 "
          },
          {
            "type": "equation_inline",
            "content": "1 8 0 ^ { \\circ }"
          },
          {
            "type": "text",
            "content": "，这样的方法获得的结论可靠吗?"
          }
        ]
      },
      "bbox": [
        122,
        295,
        916,
        345
      ],
      "reading_order": 4,
      "original_image_bbox": [
        265,
        905,
        1991,
        1059
      ],
      "model_image_bbox": [
        138,
        472,
        1036,
        552
      ],
      "pdf_page_bbox": [
        63.63,
        217.4,
        477.74,
        254.25
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "由于测量常常有误差，这样验证三角形的内角和等于 "
          },
          {
            "type": "equation_inline",
            "content": "1 8 0 ^ { \\circ }"
          },
          {
            "type": "text",
            "content": "，不能完全令人信服；又由于形状不同的三角形有无数个，我们不可能用上述方法一一验证所有三角形的内角和等于 "
          },
          {
            "type": "equation_inline",
            "content": "{ 1 8 0 } ^ { \\circ } ."
          },
          {
            "type": "text",
            "content": "，因此，需要通过推理的方法去证明：任意一个三角形的内角和等于 "
          },
          {
            "type": "equation_inline",
            "content": "1 8 0 ^ { \\circ }"
          }
        ]
      },
      "bbox": [
        122,
        352,
        918,
        458
      ],
      "reading_order": 5,
      "original_image_bbox": [
        265,
