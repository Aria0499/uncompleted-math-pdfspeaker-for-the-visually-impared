    {
      "type": "title",
      "content": {
        "title_content": [
          {
            "type": "text",
            "content": "13.3.1三角形的内角"
          }
        ],
        "level": 2
      },
      "bbox": [
        169,
        263,
        447,
        286
      ],
      "reading_order": 3,
      "original_image_bbox": [
        367,
        807,
        971,
        878
      ],
      "model_image_bbox": [
        191,
