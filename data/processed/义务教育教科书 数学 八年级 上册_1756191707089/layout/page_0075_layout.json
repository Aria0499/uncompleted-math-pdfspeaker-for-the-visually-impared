    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "（1）以点C为圆心，适当长为半径作弧，交直线AB于点D和点E；"
          }
        ]
      },
      "bbox": [
