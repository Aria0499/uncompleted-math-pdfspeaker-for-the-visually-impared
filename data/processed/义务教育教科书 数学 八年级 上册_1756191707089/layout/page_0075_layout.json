      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "（2）分别以点D和点E为圆心，大于 "
          },
          {
            "type": "equation_inline",
            "content": "\\frac { 1 } { 2 } D E"
          },
          {
            "type": "text",
            "content": "的长为半径作弧，两弧相交于点F；"
          }
        ]
      },
      "bbox": [
