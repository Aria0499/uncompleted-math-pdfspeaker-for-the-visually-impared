    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "学习了线段的垂直平分线的作法，就可以作对称轴了."
          }
        ]
      },
      "bbox": [
        125,
        164,
        668,
