        "paragraph_content": [
          {
            "type": "text",
            "content": "13.如图， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C { \\cong } \\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": ",AD, "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } D ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "分别是 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "的对应边上的中线.AD与 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } D ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "有什么关系？证明你的结论."
          }
        ]
      },
