    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "10.如图，点C是AB的中点， "
          },
          {
            "type": "equation_inline",
            "content": "C D / / B E"
          },
          {
            "type": "text",
            "content": "，且 "
          },
          {
            "type": "equation_inline",
            "content": "C D { = } B E"
          },
          {
            "type": "text",
            "content": ".求证 "
          },
          {
            "type": "equation_inline",
            "content": "A D / / C E"
          }
        ]
      },
      "bbox": [
