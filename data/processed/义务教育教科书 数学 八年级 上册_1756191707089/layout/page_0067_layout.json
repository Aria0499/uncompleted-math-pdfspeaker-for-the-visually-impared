      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "12.如图的三角形纸片ABC中， "
          },
          {
            "type": "equation_inline",
            "content": "A B { = } 8 ~ \\mathrm { c m }"
          },
          {
            "type": "text",
            "content": ", "
          },
          {
            "type": "equation_inline",
            "content": "B C { = } 6 ~ \\mathrm { c m }"
          },
          {
            "type": "text",
            "content": ", "
          },
          {
            "type": "equation_inline",
            "content": "A C = 5 ~ { \\mathrm { c m } }"
          },
          {
            "type": "text",
            "content": "．沿过点B的直线折叠这个三角形，使点C落在AB边上的点E处，折痕为BD.求 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A E D"
          },
          {
            "type": "text",
            "content": "的周长."
          }
        ]
      },
