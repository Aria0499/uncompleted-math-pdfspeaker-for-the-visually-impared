    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图14.2-7，由 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } B ^ { \\prime } { = } A B"
          },
          {
            "type": "text",
            "content": "可知，如果使点 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与点A重合，点 "
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "在射线AB上，那么点 "
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与点B重合.再由"
          },
          {
            "type": "equation_inline",
            "content": "\\angle A ^ { \\prime } = \\angle A , \\angle B ^ { \\prime } = \\angle B"
          },
          {
            "type": "text",
            "content": "，可知射线 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与射线AC重合，射线 "
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与射线BC重合，于是射线 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } C ^ { \\prime } , B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "的交点 "
          },
          {
            "type": "equation_inline",
            "content": "C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与射线AC，BC的交点C重合.这样， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "的三个顶点与 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "的三个顶点分别重合， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "能够完全重合，因而 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime } { \\cong } \\triangle A B C"
          }
        ]
      },
