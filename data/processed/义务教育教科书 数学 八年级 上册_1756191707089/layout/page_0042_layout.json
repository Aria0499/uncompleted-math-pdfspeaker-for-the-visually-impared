            "type": "equation_inline",
            "content": "A D { = } A E"
          },
          {
            "type": "text",
            "content": ".由题意可知，"
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A C D"
          },
          {
            "type": "text",
            "content": "和 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B E"
          },
          {
            "type": "text",
            "content": "具备“角边角”的条件."
          }
        ]
