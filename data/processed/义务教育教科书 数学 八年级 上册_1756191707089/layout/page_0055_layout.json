        453.23,
        457.65
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "反过来，如图14.3-2，M，N分别是 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A O B"
          },
          {
            "type": "text",
            "content": "的边OA，OB上的点， "
          },
          {
            "type": "equation_inline",
            "content": "O M = O N"
          },
          {
            "type": "text",
            "content": "．点P在 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A O B"
          },
          {
            "type": "text",
            "content": "的内部，"
          },
          {
            "type": "equation_inline",
            "content": "P M = P N"
          },
          {
            "type": "text",
            "content": "．连接OP，可以证明 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle O P M \\cong \\triangle O P N"
          },
          {
            "type": "text",
            "content": "(SSS），所以 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle P O M { = } \\angle P O N"
          },
          {
            "type": "text",
            "content": "，即点P在 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A O B"
          },
          {
            "type": "text",
            "content": "的平分线上."
          }
        ]
      },
