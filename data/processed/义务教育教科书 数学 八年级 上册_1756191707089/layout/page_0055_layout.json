    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图14.3-1，OC是 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A O B"
          },
          {
            "type": "text",
            "content": "的平分线，P是OC上的任意一点，M，N分别是OA，OB上的点，我们研究PM与PN的关系."
          }
