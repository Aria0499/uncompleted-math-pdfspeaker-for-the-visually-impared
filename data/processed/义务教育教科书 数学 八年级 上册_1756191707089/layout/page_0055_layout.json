    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "在图14.3-1中可以发现，在 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle { O P M }"
          },
          {
            "type": "text",
            "content": "和 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle { O P N }"
          },
          {
            "type": "text",
            "content": "中， "
          },
          {
            "type": "equation_inline",
            "content": "O P = O P , \\angle P O M ="
          },
          {
            "type": "equation_inline",
            "content": "\\angle P O N"
          },
          {
            "type": "text",
            "content": "．如果 "
          },
          {
            "type": "equation_inline",
            "content": "O M { = } O N"
          },
          {
            "type": "text",
            "content": "，那么 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle O P M { \\cong } \\triangle O P N"
          },
          {
            "type": "text",
            "content": "(SAS)，就有 "
          },
          {
            "type": "equation_inline",
            "content": "P M { = } P N"
          }
        ]
      },
      "bbox": [
        78,
        571,
        869,
        621
      ],
      "reading_order": 10,
      "original_image_bbox": [
        169,
        1753,
