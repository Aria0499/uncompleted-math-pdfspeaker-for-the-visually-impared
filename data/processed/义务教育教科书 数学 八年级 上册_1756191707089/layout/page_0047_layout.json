      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "（1）以点O为圆心，任意长为半径作弧，分别交OA，OB于点C，D；"
          }
        ]
      },
      "bbox": [
        125,
        67,
        842,
        90
      ],
      "reading_order": 1,
      "original_image_bbox": [
