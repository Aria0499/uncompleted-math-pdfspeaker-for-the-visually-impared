      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "（3）以点 "
          },
          {
            "type": "equation_inline",
            "content": "C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "为圆心，CD为半径作弧，与上一步作的弧相交于点 "
          },
          {
            "type": "equation_inline",
            "content": "D ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "…"
          }
        ]
      },
      "bbox": [
