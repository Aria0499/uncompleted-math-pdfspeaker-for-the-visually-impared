        66.33
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "（2）作一条射线 "
          },
          {
            "type": "equation_inline",
            "content": "O ^ { \\prime } A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "，以点 "
          },
          {
            "type": "equation_inline",
            "content": "O ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "为圆心，OC为半径作弧，交 "
          },
          {
            "type": "equation_inline",
            "content": "O ^ { \\prime } A ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "于点 "
          },
          {
            "type": "equation_inline",
            "content": "C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "…"
          }
        ]
      },
      "bbox": [
        81,
        95,
        872,
        145
      ],
      "reading_order": 2,
      "original_image_bbox": [
