    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "（4）过点 "
          },
          {
            "type": "equation_inline",
            "content": "D ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "作射线 "
          },
          {
            "type": "equation_inline",
            "content": "O ^ { \\prime } B ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "，则 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A ^ { \\prime } O ^ { \\prime } B ^ { \\prime } { = } \\angle A O B"
          }
        ]
      },
