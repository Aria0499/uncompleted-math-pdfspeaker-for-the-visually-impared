    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图14.2-10，直观上，AB，BC，CA的大小确定了， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "的形状、大小也就确定了．也就是说，在 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与"
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "中，如果 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } B ^ { \\prime } { = } A B"
          },
          {
            "type": "equation_inline",
            "content": "B ^ { \\prime } C ^ { \\prime } { = } B C"
          },
          {
            "type": "text",
            "content": ","
          },
          {
            "type": "equation_inline",
            "content": "C ^ { \\prime } A ^ { \\prime } { = } C A"
          },
          {
            "type": "text",
            "content": "，那么 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime } { \\cong } \\triangle A B C"
          },
          {
            "type": "text",
            "content": ".这个判断正确吗?"
          }
        ]
      },
