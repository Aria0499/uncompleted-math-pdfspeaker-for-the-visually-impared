    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "几何图形都可以看作由点组成．对于一些规则的几"
          }
        ]
      },
      "bbox": [
        125,
        505,
        646,
        527
      ],
      "reading_order": 8,
      "original_image_bbox": [
        271,
        1550,
        1404,
