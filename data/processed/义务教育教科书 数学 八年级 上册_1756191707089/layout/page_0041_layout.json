    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "2.如图，点E，F在BC上，BE=CF， "
          },
          {
            "type": "equation_inline",
            "content": "A B { = } D C"
          },
          {
            "type": "equation_inline",
            "content": "\\angle B = \\angle C ."
          },
          {
            "type": "text",
            "content": "求证 "
