    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "如图14.2-6，直观上， "
          },
          {
            "type": "equation_inline",
            "content": "A B , \\angle A , \\angle B"
          },
          {
            "type": "text",
            "content": "的大小确定了， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "的形状、大小也就确定了．也就是说，在 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime }"
          },
          {
            "type": "text",
            "content": "与 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "中，如果 "
          },
          {
            "type": "equation_inline",
            "content": "A ^ { \\prime } B ^ { \\prime } ="
          },
          {
            "type": "text",
            "content": "AB, "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A ^ { \\prime } { = } \\angle A"
          },
          {
            "type": "text",
            "content": ", "
          },
          {
            "type": "equation_inline",
            "content": "\\angle B ^ { \\prime } { = } \\angle B"
          },
          {
            "type": "text",
            "content": "，那么 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A ^ { \\prime } B ^ { \\prime } C ^ { \\prime } \\cong"
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C"
          },
          {
            "type": "text",
            "content": "，这个判断正确吗?"
          }
        ]
      },
