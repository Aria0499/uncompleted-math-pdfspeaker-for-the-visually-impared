    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "轴对称图形和两个图形成轴对称有什么区别和联系？"
          }
        ]
      },
      "bbox": [
        194,
        694,
        719,
        715
      ],
      "reading_order": 13,
      "original_image_bbox": [
        421,
        2131,
        1563,
        2195
      ],
      "model_image_bbox": [
