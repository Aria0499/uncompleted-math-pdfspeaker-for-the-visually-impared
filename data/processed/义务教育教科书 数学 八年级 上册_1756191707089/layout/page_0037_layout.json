        207.58,
        249.09
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "全等三角形的对应边相等，全等三角形的对应角相等."
          }
        ]
      },
      "bbox": [
        125,
        347,
        668,
        368
      ],
      "reading_order": 7,
      "original_image_bbox": [
        271,
        1065,
