    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "\\therefore \\angle E = 1 8 0 ^ { \\circ } - \\angle B A E - \\angle A B E = 1 8 0 ^ { \\circ } - 6 5 ^ { \\circ } - 6 5 ^ { \\circ } = 5 0 ^ { \\circ } .",
