    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "在 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A E B"
          },
          {
            "type": "text",
            "content": "中， "
          },
          {
            "type": "equation_inline",
            "content": "\\angle E + \\angle B A E + \\angle A B E = 1 8 0 ^ { \\circ }"
          }
        ]
      },
      "bbox": [
        125,
        545,
