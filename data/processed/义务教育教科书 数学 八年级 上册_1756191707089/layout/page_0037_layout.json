      ],
      "reading_order": 10,
      "original_image_bbox": [
        282,
        1501,
        884,
        1560
      ],
      "model_image_bbox": [
        147,
        782,
        460,
        812
      ],
      "pdf_page_bbox": [
        67.8,
        360.37,
        212.27,
        374.37
      ]
    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "\\therefore \\angle C B D = \\angle A B D - \\angle A B C = 6 5 ^ { \\circ } - 2 6 ^ { \\circ } = 3 9 ^ { \\circ } .",
        "math_type": "latex",
        "image_source": {
          "path": "images/a0e842c0c36d0e0d53fe3b1b62de0cc5cb304cda9ec3195b77ab2b7bf7acf61c.jpg"
        }
      },
      "bbox": [
