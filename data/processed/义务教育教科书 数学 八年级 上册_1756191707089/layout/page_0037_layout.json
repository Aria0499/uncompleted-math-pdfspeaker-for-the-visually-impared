    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "作对应边，重合的角叫作对应角.例如，图14.1-2(1)中 "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C { \\cong } \\triangle D E F"
          },
          {
            "type": "text",
            "content": "，其中点A和点D，点B和点E，点C和点F是对应顶点；AB和DE，BC和EF，AC和DF是对应边； "
          },
          {
            "type": "equation_inline",
            "content": "\\angle A"
          },
          {
            "type": "text",
            "content": "和 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle D , \\angle B"
          },
          {
            "type": "text",
            "content": "和"
          },
          {
            "type": "equation_inline",
            "content": "\\angle E , \\ \\angle C"
          },
          {
            "type": "text",
            "content": "和 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle F"
          },
          {
            "type": "text",
            "content": "是对应角."
          }
        ]
      },
      "bbox": [
        78,
        67,
