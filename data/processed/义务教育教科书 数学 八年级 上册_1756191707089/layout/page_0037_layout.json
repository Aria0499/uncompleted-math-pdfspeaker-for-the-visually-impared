    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "全等三角形有这样的性质："
          }
        ]
      },
      "bbox": [
        125,
        317,
        398,
        338
      ],
      "reading_order": 6,
      "original_image_bbox": [
        271,
        973,
