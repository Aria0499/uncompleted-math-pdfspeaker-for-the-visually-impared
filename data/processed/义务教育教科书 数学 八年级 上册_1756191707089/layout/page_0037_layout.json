      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "例如图14.1-3， "
          },
          {
            "type": "equation_inline",
            "content": "\\triangle A B C { \\cong } \\triangle B A D"
          },
          {
            "type": "text",
            "content": "，点A和点B，点C和点D是对应顶点， "
          },
          {
            "type": "equation_inline",
            "content": "\\angle B A C = 6 5 ^ { \\circ } , \\angle A B C = 2 6 ^ { \\circ }"
          },
          {
            "type": "text",
            "content": "，AC，BD的延长线相交于点E.求 "
          },
          {
            "type": "equation_inline",
            "content": "\\angle C B D"
          },
          {
            "type": "equation_inline",
            "content": "\\angle E"
          },
          {
            "type": "text",
            "content": "的度数."
          }
        ]
      },
      "bbox": [
        81,
        375,
        872,
        453
      ],
      "reading_order": 8,
      "original_image_bbox": [
        176,
        1151,
        1895,
        1391
      ],
      "model_image_bbox": [
        91,
        600,
        987,
        724
      ],
      "pdf_page_bbox": [
        42.25,
        276.36,
        454.79,
        333.84
      ]
    },
    {
      "type": "paragraph",
      "content": {
        "paragraph_content": [
          {
            "type": "text",
            "content": "解： "
          },
          {
            "type": "equation_inline",
            "content": "\\because \\Delta A B C \\cong \\Delta B A D"
          }
        ]
      },
      "bbox": [
        125,
        460,
        407,
        480
      ],
      "reading_order": 9,
      "original_image_bbox": [
        271,
        1412,
        884,
        1474
      ],
      "model_image_bbox": [
        141,
        736,
        460,
        768
      ],
      "pdf_page_bbox": [
        65.19,
        339.0,
        212.27,
        353.74
      ]
    },
    {
      "type": "equation_interline",
      "content": {
        "math_content": "\\therefore \\angle A B D = \\angle B A C = 6 5 ^ { \\circ } .",
        "math_type": "latex",
        "image_source": {
          "path": "images/811e1fda3d8733192331b20a581320af4fb868445c0e5aa29e2b196f3439bd2f.jpg"
        }
      },
      "bbox": [
        130,
        489,
